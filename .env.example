# Copy to `.env` and fill in values from Google Cloud Console.
# https://console.developers.google.com/apis/credentials

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required for Sign in with Google (Analysis tab).
GOOGLE_CLIENT_ID=

# Local development only. Google refuses to serve its sign-in button to an origin
# that is not registered on the OAuth client, which blocks the whole wizard on an
# unregistered dev machine. Set to 1 to expose a "Continue as local developer"
# button that links a dedicated user row. Never set this in a deployment.
DSS_DEV_SIGNIN=0

# Required only for custom-button / auth-code flows.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000
